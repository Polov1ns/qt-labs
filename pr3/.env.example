# Зразок налаштувань для ПР3
# Скопіюйте цей файл у .env і впишіть свій ключ:
# copy .env.example .env (Windows) або cp .env.example .env (Linux/macOS)

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі (підтримуються обидва варіанти назви змінної)
LLM_MODEL=gemini-3.8-flash
LLM_MODEL_NAME=gemini-3.8-flash

# Параметри генерації
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500

# Скільки секунд чекати на відповідь, перш ніж перервати запит
LLM_TIMEOUT=30
